      "details": {
        "schema": "public",
        "objectType": "foreignKey",
        "name": "availability_userId_fkey",
        "table": "availability"
      }
    },
    "precheck": [
      {
        "description": "ensure FK \"availability_userId_fkey\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "availability_userId_fkey",
          "public",
          "\"public\".\"availability\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add FK \"availability_userId_fkey\"",
        "sql": "ALTER TABLE \"public\".\"availability\"\nADD CONSTRAINT \"availability_userId_fkey\"\nFOREIGN KEY (\"userId\")\nREFERENCES \"public\".\"user\" (\"id\")"
      }
    ],
    "postcheck": [
      {
        "description": "verify FK \"availability_userId_fkey\" exists",
